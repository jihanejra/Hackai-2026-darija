# Copy this file to .env and fill in your own keys.
# .env is ignored by git: never commit your real keys.

# Groq (required): https://console.groq.com/keys
GROQ_API_KEY=

# LangSmith tracing (optional): https://smith.langchain.com -> Settings -> API Keys
# Set LANGSMITH_TRACING=false if you don't have a key.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hack_ai

# Google AI Studio (Gemini), used by the MCP notebook: https://aistudio.google.com
GEMINI_API_KEY=
